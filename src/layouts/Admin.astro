---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '../styles/admin.css';
import { count, isNull } from 'drizzle-orm';
import { db, schema } from '../db/client.ts';
import { useAdminUi } from '../i18n/admin.ts';
import type { AdminLocale } from '../i18n/config.ts';

interface Props {
  title: string;
  /** Language of the page when nobody is signed in (login form). */
  locale?: AdminLocale;
}

const user = Astro.locals.user;
const locale = user?.locale ?? Astro.props.locale ?? 'ro';
const t = useAdminUi(locale);
const { title } = Astro.props;
const current = Astro.url.pathname;
const pending = user ? db.select({ n: count() }).from(schema.contactMessages).where(isNull(schema.contactMessages.handledAt)).get()!.n : 0;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} – {t.title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    {
      user && (
        <header class="admin-header">
          <a class="admin-header__brand" href="/admin">
            <img src="/favicon.svg" alt="" width="28" height="28" />
            {t.title}
          </a>
          <nav>
            <a href="/admin" aria-current={current === '/admin' || current.startsWith('/admin/animals') ? 'page' : undefined}>{t.nav.animals}</a>
            <a href="/admin/pages" aria-current={current.startsWith('/admin/pages') ? 'page' : undefined}>{t.nav.pages}</a>
            <a href="/admin/messages" aria-current={current === '/admin/messages' ? 'page' : undefined}>
              {t.nav.messages}
              {pending > 0 && <span class="count">{pending}</span>}
            </a>
            <a href="/admin/redirects" aria-current={current === '/admin/redirects' ? 'page' : undefined}>{t.nav.redirects}</a>
            <a href="/admin/theme" aria-current={current === '/admin/theme' ? 'page' : undefined}>{t.nav.theme}</a>
            <a href="/" target="_blank" rel="noopener">{t.nav.site} ↗</a>
          </nav>
          <form method="post" action="/admin/logout">
            <span>{user.name}</span>
            <button class="link" type="submit">{t.nav.logout}</button>
          </form>
        </header>
      )
    }
    <main class="admin-main">
      <slot />
    </main>
  </body>
</html>
