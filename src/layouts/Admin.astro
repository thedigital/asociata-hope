---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '../styles/admin.css';
import { count, isNull } from 'drizzle-orm';
import { db, schema } from '../db/client.ts';
import { useAdminUi } from '../i18n/admin.ts';
import type { AdminLocale } from '../i18n/config.ts';

interface Props {
  title: string;
  /** Language of the page when nobody is signed in (login form). */
  locale?: AdminLocale;
}

const user = Astro.locals.user;
const locale = user?.locale ?? Astro.props.locale ?? 'ro';
const t = useAdminUi(locale);
const { title } = Astro.props;
const current = Astro.url.pathname;
const pendingMessages = user ? db.select({ n: count() }).from(schema.contactMessages).where(isNull(schema.contactMessages.handledAt)).get()!.n : 0;
const under = (path: string) => current === path || current.startsWith(`${path}/`);
// The list of animals is the first screen of the admin.
const menu = [
  { href: '/admin', label: t.nav.animals, current: current === '/admin' || under('/admin/animals') },
  { href: '/admin/pages', label: t.nav.pages, current: under('/admin/pages') },
  { href: '/admin/campaigns', label: t.nav.campaigns, current: under('/admin/campaigns') },
  { href: '/admin/messages', label: t.nav.messages, current: under('/admin/messages'), count: pendingMessages },
  { href: '/admin/redirects', label: t.nav.redirects, current: under('/admin/redirects') },
  { href: '/admin/theme', label: t.nav.theme, current: under('/admin/theme') },
  { href: '/admin/users', label: t.nav.users, current: under('/admin/users') },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} – {t.title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    {
      user && (
        <header class="admin-header">
          <a class="admin-header__brand" href="/admin">
            <img src="/favicon.svg" alt="" width="28" height="28" />
            {t.title}
          </a>
          <nav>
            {
              menu.map((entry) => (
                <a href={entry.href} aria-current={entry.current ? 'page' : undefined}>
                  {entry.label}
                  {entry.count ? <span class="count">{entry.count}</span> : null}
                </a>
              ))
            }
            <a href="/" target="_blank" rel="noopener">{t.nav.site} ↗</a>
          </nav>
          <form method="post" action="/admin/logout">
            <span>{user.name}</span>
            <button class="link" type="submit">{t.nav.logout}</button>
          </form>
        </header>
      )
    }
    <main class="admin-main">
      <slot />
    </main>
    {
      user && (
        <script is:inline nonce={Astro.locals.cspNonce}>
          // Handle confirmation dialogs on buttons with data-confirm
          document.querySelectorAll('[data-confirm]').forEach((button) => {
            button.addEventListener('click', (event) => {
              if (!confirm(button.dataset.confirm)) event.preventDefault();
            });
          });
        </script>
      )
    }
  </body>
</html>
