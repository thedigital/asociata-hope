---
import type { Locale } from '../i18n/config.ts';
import { localizePath } from '../i18n/config.ts';
import { formatAge, gendered, joinList, useUi } from '../i18n/ui.ts';
import type { Collection, getAnimal } from '../lib/animals.ts';
import type { Campaign } from '../lib/campaigns.ts';
import { imageUrl } from '../lib/media.ts';
import CampaignProgress from './CampaignProgress.astro';
import DetailList from './DetailList.astro';
import Paragraphs from './Paragraphs.astro';
import Picture from './Picture.astro';

interface Props {
  collection: Collection;
  animal: NonNullable<ReturnType<typeof getAnimal>>;
  locale: Locale;
  /** Open fundraising campaign for this animal, if any. */
  campaign?: Campaign | null;
}

const { collection, animal, locale, campaign = null } = Astro.props;
const ui = useUi(locale);
const listUrl = localizePath(`/${collection.path}`, locale);
const isVirtual = collection.adoptionType === 'virtual';
const contactReason = isVirtual ? 'sponsorship' : animal.species === 'dog' ? 'adopt-dog' : 'adopt-cat';

// Lower-case every label but the first, as in a sentence: "Docile and affectionate".
const sentence = (labels: string[]) => joinList(labels.map((label, i) => (i ? label.toLowerCase() : label)), ui.and);
const health = (['vaccinated', 'sterilized', 'dewormed'] as const).filter((key) => animal[key]).map((key) => gendered(ui.health[key], animal.sex));
const facts = ([
  [ui.animal.age, animal.ageMonths === null ? null : formatAge(ui, animal.ageMonths)],
  [ui.animal.size, animal.size ? gendered(ui.size[animal.size], animal.sex) : null],
  [ui.animal.color, animal.color ? ui.color[animal.color] : null],
  [ui.animal.sex, animal.sex ? ui.sex[animal.sex] : null],
  [ui.animal.behavior, animal.traits.length ? sentence(animal.traits.map((t) => gendered(ui.traits[t], animal.sex))) : null],
  [ui.animal.health, health.length ? sentence(health) : null],
] as const).filter((fact): fact is readonly [string, string] => Boolean(fact[1]));

const [main, ...others] = animal.photos;
---

<article class="animal">
  <div class="animal__inner">
    <a class="animal__back" href={listUrl}>‹ {ui.animal.back}</a>

    <div class="animal__gallery">
      {
        main && (
          <a class="animal__photo" href={imageUrl('animals', main.file, 1200)}>
            <Picture
              id="animal-photo"
              kind="animals"
              file={main.file}
              widths={[400, 800, 1200]}
              sizes="(min-width: 900px) 480px, 100vw"
              alt={main.alt || animal.name}
              width={main.width ?? 800}
              height={main.height ?? 800}
              priority
            />
          </a>
        )
      }
      {
        others.length > 0 && (
          <ul class="animal__thumbs">
            {animal.photos.map((photo, index) => (
              <li>
                <a href={imageUrl('animals', photo.file, 1200)} data-file={photo.file} aria-current={index === 0 ? 'true' : undefined}>
                  <img src={imageUrl('animals', photo.file, 160)} alt={photo.alt || ui.animal.photoOf(animal.name, index + 1)} width="160" height="160" loading="lazy" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
      {
        animal.videoFile && (
          <video class="animal__video" controls preload="none" poster={main ? imageUrl('animals', main.file, 800) : undefined}>
            <source src={`/media/videos/${animal.videoFile}`} type="video/mp4" />
          </video>
        )
      }
    </div>

    <div class="animal__card">
      {isVirtual && <p class="animal__badge">{ui.animal.virtualAdoption}</p>}
      <h1>{animal.name}</h1>
      <DetailList items={facts} />
      <Paragraphs class="animal__description" text={animal.translation?.description ?? ''} lang={animal.translation?.locale} />
      {
        animal.videoUrl && (
          <p>
            <a href={animal.videoUrl} rel="noopener" target="_blank">
              ▶ Video
            </a>
          </p>
        )
      }
      {
        campaign && (
          <aside class="campaign-box">
            <p class="campaign-card__scope">{ui.campaigns.animalBox}</p>
            <h2 lang={campaign.textLocale}>{campaign.title}</h2>
            {campaign.summary && <p lang={campaign.textLocale}>{campaign.summary}</p>}
            <CampaignProgress campaign={campaign} locale={locale} />
            <a class="button button--small" href={localizePath(campaign.path, locale)}>{ui.campaigns.see}</a>
          </aside>
        )
      }
      <div class="animal__actions">
        {isVirtual && <a class="button" href={`${localizePath('/doneaza', locale)}?animal=${encodeURIComponent(animal.name)}#card`}>{ui.animal.sponsor}</a>}
        <a class={isVirtual ? 'button button--sand' : 'button'} href={`${localizePath('/contact', locale)}?reason=${contactReason}&animal=${encodeURIComponent(animal.name)}#contact-body`}>{ui.animal.contact}</a>
        <a class="button button--sand" href={listUrl}>{ui.animal.seeOthers[animal.species]}</a>
      </div>
    </div>
  </div>
</article>

<script is:inline nonce={Astro.locals.cspNonce}>
  // Thumbnails swap the main picture in place; without JavaScript they open the full-size image.
  (() => {
    const main = document.getElementById('animal-photo');
    const thumbs = document.querySelectorAll('.animal__thumbs a');
    if (!main) return;
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', (event) => {
        event.preventDefault();
        const file = thumb.dataset.file;
        const url = (width) => `/media/animals/${width}/${file}`;
        main.srcset = [400, 800, 1200].map((w) => `${url(w)} ${w}w`).join(', ');
        main.src = url(800);
        main.alt = thumb.querySelector('img').alt;
        main.removeAttribute('width');
        main.removeAttribute('height');
        main.parentElement.href = url(1200);
        thumbs.forEach((other) => other.removeAttribute('aria-current'));
        thumb.setAttribute('aria-current', 'true');
      });
    });
  })();
</script>
