---
import type { Locale } from '../i18n/config.ts';
import { localizePath } from '../i18n/config.ts';
import { useUi } from '../i18n/ui.ts';
import { CAMPAIGNS_PATH, type Campaign } from '../lib/campaigns.ts';
import CampaignProgress from './CampaignProgress.astro';
import DonateForm from './DonateForm.astro';
import GiveMethod from './GiveMethod.astro';
import PageHero from './PageHero.astro';
import Paragraphs from './Paragraphs.astro';
import Picture from './Picture.astro';

interface Props {
  campaign: Campaign;
  locale: Locale;
  error: string | null;
  cancelled: boolean;
}

/**
 * Page of a campaign, built like the donation page: a first sheet says what the money is for and
 * where the campaign stands, the second one holds the card form (or says the campaign is closed),
 * the last one points to the other ways of giving.
 */
const { campaign, locale, error, cancelled } = Astro.props;
const ui = useUi(locale);
const t = ui.campaigns;
const href = (path: string) => localizePath(path, locale);
const open = campaign.state === 'open';
---

<PageHero title={campaign.title} lang={campaign.textLocale} lead={campaign.summary} />
<div class="container give campaign">
  <section class:list={['give__intro', 'campaign__about', { 'campaign__about--photo': campaign.image }]}>
    {
      campaign.image && (
        <Picture
          class="campaign__image"
          kind={campaign.image.kind}
          file={campaign.image.file}
          widths={[400, 800, 1200]}
          sizes="(min-width: 800px) 400px, 100vw"
          alt=""
          priority
        />
      )
    }
    <div class="campaign__text">
      <p class="campaign-card__scope">{t.scopes[campaign.scope]}</p>
      <CampaignProgress campaign={campaign} locale={locale} />
      <Paragraphs class="campaign__description" text={campaign.description} lang={campaign.textLocale} />
      {
        campaign.animal && (
          <p class="campaign__animal">
            {t.forAnimal(campaign.animal.name)} <a href={href(campaign.animal.path)}>{t.seeAnimal}</a>
          </p>
        )
      }
    </div>
  </section>

  <GiveMethod
    id="card"
    icon="card"
    title={open ? t.give : campaign.state === 'reached' ? t.reached : t.ended}
    hint={open ? t.giveHint : t.closedText}
  >
    {
      open ? (
        <DonateForm locale={locale} animal={null} error={error} cancelled={cancelled} campaign={campaign} />
      ) : (
        <a class="button" href={href('/doneaza')}>{ui.donate}</a>
      )
    }
  </GiveMethod>

  {
    open && (
      <section class="give-method campaign__other">
        <h2>{t.otherWays}</h2>
        <p>{t.otherWaysText(campaign.title)}</p>
        <a class="button button--sand" href={`${href('/doneaza')}#transfer`}>{t.otherWaysLink}</a>
      </section>
    )
  }

  <p class="campaign__back">
    <a href={href(`/${CAMPAIGNS_PATH}`)}>‹ {t.all}</a>
  </p>
</div>
