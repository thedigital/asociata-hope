---
import type { Locale } from '../i18n/config.ts';
import { useFormsUi } from '../i18n/forms.ts';
import { localizePath } from '../i18n/config.ts';
import { useUi } from '../i18n/ui.ts';
import { listCampaigns } from '../lib/campaigns.ts';
import type { IconName } from '../lib/icons.ts';
import { DONATION_METHODS, SITE, type DonationMethod } from '../lib/site.ts';
import Icon from './Icon.astro';
import GiveMethod from './GiveMethod.astro';
import CopyValue from './CopyValue.astro';
import DetailList from './DetailList.astro';
import DonateForm from './DonateForm.astro';
import RedirectSummary from './RedirectSummary.astro';

interface Props {
  locale: Locale;
  animal: string | null;
  error: string | null;
  cancelled: boolean;
}

/**
 * Body of the donation page: the list of the ways of giving, then one section per method, all
 * built the same way. The details come from `SITE` and the strings from `src/i18n/forms.ts`, so
 * the page is identical in every language (the body stored for this page is ignored).
 */
const { locale, ...form } = Astro.props;
const t = useFormsUi(locale).donate;
const ui = useUi(locale);
const redirectTitle = ui.homePage.redirectTitle;
// Campaigns that accept gifts are offered before the general ways of giving.
const campaigns = listCampaigns(locale).filter((campaign) => campaign.state === 'open');
const title = (method: DonationMethod) => (method === 'redirect' ? redirectTitle : t.titles[method]);

const ICONS: Record<DonationMethod, IconName> = {
  card: 'card',
  transfer: 'transfer',
  paypal: 'paypal',
  sms: 'message',
  redirect: 'form',
};

/** An IBAN is easier to read, and to check, in groups of four. */
const grouped = (iban: string) => iban.replace(/(.{4})(?=.)/g, '$1 ');
---

<div class="container give">
  <div class="give__intro">
    <p class="give__lead">{t.lead}</p>
    <nav class="give-nav" aria-label={t.pick}>
      <p class="give-nav__title">{t.pick}</p>
      <ul>
        {
          DONATION_METHODS.map((method) => (
            <li>
              <a href={`#${method}`}>
                <Icon name={ICONS[method]} class="give-icon" />
                <strong>{t.methods[method].label}</strong>
                <span>{t.methods[method].hint}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  {
    campaigns.length > 0 && (
      <section class="give-method give-campaigns" aria-labelledby="campaigns-title">
        <h2 id="campaigns-title">{ui.campaigns.inProgress}</h2>
        <ul>
          {campaigns.map((campaign) => (
            <li>
              <a href={localizePath(campaign.path, locale)}>
                <strong lang={campaign.textLocale}>{campaign.title}</strong>
                {campaign.summary && <span lang={campaign.textLocale}>{campaign.summary}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    DONATION_METHODS.map((method) => (
      <GiveMethod id={method} icon={ICONS[method]} title={title(method)} hint={t.methods[method].hint}>
        {method === 'card' && <DonateForm locale={locale} {...form} />}

        {method === 'transfer' && (
          <>
            <DetailList
              items={[
                [t.transfer.beneficiary, SITE.legalName],
                [t.transfer.fiscalCode, SITE.fiscalCode],
                [t.transfer.bank, SITE.bank],
                [t.transfer.swift, SITE.swift],
              ]}
              class="give-details"
            />
            <ul class="give-accounts">
              {Object.entries(SITE.accounts).map(([currency, iban]) => (
                <CopyValue as="li" locale={locale} value={iban} shown={grouped(iban)}>
                  <span class="give-accounts__currency">IBAN <b>{currency}</b></span>
                </CopyValue>
              ))}
            </ul>
          </>
        )}

        {method === 'paypal' && (
          <CopyValue locale={locale} value={SITE.email} stacked>
            <span class="give-copy__label">{t.paypal.account}</span>
          </CopyValue>
        )}

        {method === 'sms' && (
          <>
            <DetailList
              items={[
                [t.sms.text, SITE.sms.text],
                [t.sms.number, SITE.sms.number],
                [t.sms.gift, t.sms.amount],
              ]}
              class="give-sms"
            />
            <p class="form-note">{t.sms.legal}</p>
          </>
        )}

        {method === 'redirect' && (
          <div class="prose prose--plain">
            <RedirectSummary locale={locale} heading={false} />
          </div>
        )}
      </GiveMethod>
    ))
  }
</div>

<script is:inline nonce={Astro.locals.cspNonce}>
  // Copy buttons only exist where the clipboard does; the label confirms the copy for a moment.
  (() => {
    if (!navigator.clipboard) return;
    document.querySelectorAll('[data-copy]').forEach((button) => {
      const label = button.textContent;
      button.hidden = false;
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(button.dataset.copy);
        button.textContent = button.dataset.copied;
        button.classList.add('is-copied');
        setTimeout(() => {
          button.textContent = label;
          button.classList.remove('is-copied');
        }, 2000);
      });
    });
  })();
</script>
