---
import AnimalCard from './AnimalCard.astro';
import type { Locale } from '../i18n/config.ts';
import { localizePath } from '../i18n/config.ts';
import { gendered, useUi } from '../i18n/ui.ts';
import { AGE_GROUPS, ageGroup, type AnimalCard as Card, type Collection } from '../lib/animals.ts';
import type { PageKey } from '../lib/site.ts';
import { COLORS, SEXES, SIZES, TRAITS } from '../lib/taxonomy.ts';

interface Props {
  collection: Collection;
  animals: Card[];
  locale: Locale;
  filters: URLSearchParams;
}

const { collection, animals, locale, filters } = Astro.props;
const ui = useUi(locale);
const base = localizePath(`/${collection.path}`, locale);

// Only offer values that at least one animal of this collection has.
const present = <T extends string>(all: readonly T[], pick: (a: Card) => T | T[] | null) => all.filter((value) => animals.some((a) => [pick(a)].flat().includes(value)));
const options = {
  sex: present(SEXES, (a) => a.sex),
  size: present(SIZES, (a) => a.size),
  color: present(COLORS, (a) => a.color),
  trait: present(TRAITS, (a) => a.traits),
  age: present(AGE_GROUPS, (a) => (a.ageMonths === null ? null : ageGroup(a.ageMonths))),
};
// Colour and trait accept several values (repeated parameter): an animal matches when it has one of them.
const selected = Object.fromEntries(Object.entries(options).map(([key, values]) => [key, filters.getAll(key).filter((value) => (values as readonly string[]).includes(value))]));
const matches = (a: Card) =>
  (!selected.sex.length || a.sex === selected.sex[0]) &&
  (!selected.size.length || a.size === selected.size[0]) &&
  (!selected.color.length || (a.color !== null && selected.color.includes(a.color))) &&
  (!selected.trait.length || a.traits.some((trait) => selected.trait.includes(trait))) &&
  (!selected.age.length || (a.ageMonths !== null && ageGroup(a.ageMonths) === selected.age[0]));
const visible = animals.filter(matches);
const filtered = Object.values(selected).some((values) => values.length);

const fields = [
  { name: 'sex', label: ui.animal.sex, values: options.sex.map((v) => [v, ui.sex[v]]) },
  { name: 'age', label: ui.filters.ageGroup, values: options.age.map((v) => [v, ui.filters[v]]) },
  { name: 'size', label: ui.animal.size, values: options.size.map((v) => [v, gendered(ui.size[v], null)]) },
  { name: 'color', label: ui.animal.color, multiple: true, values: options.color.map((v) => [v, ui.color[v]]) },
  { name: 'trait', label: ui.filters.trait, multiple: true, values: options.trait.map((v) => [v, gendered(ui.traits[v], null)]).sort((a, b) => a[1].localeCompare(b[1], locale)) },
].filter((field) => field.values.length > 1);
---

<section class="page-hero">
  <h1>{ui.pages[collection.path as PageKey]}</h1>
  <p class="page-hero__lead">{collection.adoptionType === 'virtual' ? ui.homePage.virtualLead : ui.homePage.adoptionsLead}</p>
</section>

<section class="container animal-list">
  <form class="filters" method="get" action={base} aria-label={ui.filters.title}>
    {
      fields.map((field) =>
        field.multiple ? (
          <div class="filters__field">
            <span>{field.label}</span>
            <details class="filters__multi" data-filter={field.name}>
              <summary>
                {field.values
                  .filter(([value]) => selected[field.name].includes(value))
                  .map(([, label]) => label)
                  .join(', ') || ui.filters.any}
              </summary>
              <div class="filters__options" role="group" aria-label={field.label}>
                {field.values.map(([value, label]) => (
                  <label>
                    <input type="checkbox" name={field.name} value={value} checked={selected[field.name].includes(value)} />
                    {label}
                  </label>
                ))}
              </div>
            </details>
          </div>
        ) : (
          <label class="filters__field">
            <span>{field.label}</span>
            <select name={field.name}>
              <option value="">{ui.filters.any}</option>
              {field.values.map(([value, label]) => (
                <option value={value} selected={selected[field.name][0] === value}>
                  {label}
                </option>
              ))}
            </select>
          </label>
        ),
      )
    }
    <noscript><button class="button button--small" type="submit">{ui.filters.apply}</button></noscript>
    {filtered && <a class="filters__reset" href={base}>{ui.filters.reset}</a>}
  </form>

  <p class="animal-list__count" aria-live="polite">{ui.filters.count(visible.length)}</p>

  {
    visible.length ? (
      <ul class="animal-grid">
        {visible.map((animal, index) => (
          <AnimalCard animal={animal} locale={locale} eager={index < 4} />
        ))}
      </ul>
    ) : (
      <p class="animal-list__empty">{ui.filters.none}</p>
    )
  }
</section>

<script is:inline>
  // Filters apply as soon as they change; without JavaScript the form has a submit button.
  (() => {
    const form = document.querySelector('.filters');
    if (!form) return;
    const OPEN_KEY = 'filters-open';
    const remember = (name) => {
      try {
        name ? sessionStorage.setItem(OPEN_KEY, name) : sessionStorage.removeItem(OPEN_KEY);
      } catch {}
    };

    form.addEventListener('change', (event) => {
      // A list of checkboxes stays open after the page reloads, to tick several values in a row.
      remember(event.target.closest('.filters__multi')?.dataset.filter);
      // Drop empty parameters so unfiltered URLs stay clean.
      for (const select of form.querySelectorAll('select')) select.disabled = !select.value;
      form.submit();
    });

    let reopen = null;
    try {
      reopen = sessionStorage.getItem(OPEN_KEY);
    } catch {}
    remember(null);
    const reopened = reopen && form.querySelector(`.filters__multi[data-filter="${CSS.escape(reopen)}"]`);
    if (reopened) reopened.open = true;

    const closeAll = (except) => {
      for (const multi of form.querySelectorAll('.filters__multi[open]')) if (multi !== except) multi.open = false;
    };
    document.addEventListener('click', (event) => closeAll(event.target.closest?.('.filters__multi')));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeAll(null);
    });
  })();
</script>
