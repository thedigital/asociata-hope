---
import type { Locale } from '../i18n/config.ts';
import { useFormsUi } from '../i18n/forms.ts';
import { LOCALE_CURRENCIES, type Campaign } from '../lib/campaigns.ts';
import { AMOUNTS, CURRENCIES, FREQUENCIES, type Frequency } from '../lib/stripe.ts';

interface Props {
  locale: Locale;
  /** Animal the donation is for (sponsorship), shown and passed on to Stripe. */
  animal: string | null;
  error: string | null;
  cancelled: boolean;
  /** Campaign the donation is for. A temporary one has a last day: one-off gifts only. */
  campaign?: Campaign | null;
}

const { locale, animal, error, cancelled, campaign = null } = Astro.props;
const t = useFormsUi(locale).donate;
const message = error && error in t.errors ? t.errors[error as keyof typeof t.errors] : null;
const frequencies: readonly Frequency[] = campaign?.temporary ? ['once'] : FREQUENCIES;
// The page of a campaign shows its amounts in the currency of the language: the form starts with the same one.
const defaultCurrency = campaign ? LOCALE_CURRENCIES[locale] : CURRENCIES[0];
// A sponsorship is a monthly gift by nature.
const defaultFrequency: Frequency = animal ? 'monthly' : 'once';
---

<form class="donate-form" method="post" action="/donate">
  {message && <p class="form-notice form-notice--error" role="alert">{message}</p>}
  {cancelled && <p class="form-notice" role="status">{t.cancelled}</p>}
  {animal && <p class="form-notice form-notice--ok">{t.forAnimal(animal)}</p>}

  <input type="hidden" name="locale" value={locale} />
  {animal && <input type="hidden" name="animal" value={animal} />}

  {campaign && <input type="hidden" name="campaign" value={campaign.slug} />}
  {frequencies.length === 1 && <input type="hidden" name="frequency" value={frequencies[0]} />}

  <div class="donate-form__options">
    {
      frequencies.length > 1 && (
        <div class="segmented" role="radiogroup" aria-label={t.frequency.once + ' / ' + t.frequency.monthly}>
          {frequencies.map((frequency) => (
            <label>
              <input type="radio" name="frequency" value={frequency} checked={frequency === defaultFrequency} />
              <span>{t.frequency[frequency]}</span>
            </label>
          ))}
        </div>
      )
    }

    <div class="segmented segmented--small" role="radiogroup" aria-label={t.currency}>
      {
        CURRENCIES.map((currency) => (
          <label>
            <input type="radio" name="currency" value={currency} checked={currency === defaultCurrency} />
            <span>{t.currencies[currency]}</span>
          </label>
        ))
      }
    </div>
  </div>

  <p class="donate-form__label">{t.amount}</p>
  {
    CURRENCIES.map((currency) => (
      <div class="amounts" data-currency={currency} hidden={currency !== defaultCurrency}>
        {AMOUNTS[currency].presets.map((amount, position) => (
          <label>
            <input type="radio" name="amount" value={amount} checked={position === 2} disabled={currency !== defaultCurrency} />
            <span>
              {amount} <small>{currency.toUpperCase()}</small>
            </span>
          </label>
        ))}
      </div>
    ))
  }
  <label class="field">
    <span>{t.other}</span>
    <input type="text" name="customAmount" inputmode="decimal" pattern="[0-9]+([.,][0-9]{1,2})?" maxlength="9" autocomplete="off" />
  </label>

  <button class="button button--teal" type="submit">{t.submit}</button>
  <p class="form-note">🔒 {t.secure}</p>
</form>

<script is:inline nonce={Astro.locals.cspNonce}>
  // Show the suggested amounts of the selected currency only.
  (() => {
    const form = document.querySelector('.donate-form');
    if (!form) return;
    const sync = () => {
      const currency = form.elements.currency.value;
      form.querySelectorAll('[data-currency]').forEach((group) => {
        const active = group.dataset.currency === currency;
        group.hidden = !active;
        group.querySelectorAll('input').forEach((input, index) => {
          input.disabled = !active;
          if (active && index === 2 && !group.querySelector('input:checked')) input.checked = true;
        });
      });
    };
    form.querySelectorAll('input[name=currency]').forEach((input) => input.addEventListener('change', sync));
    // Typing a custom amount deselects the suggestions.
    form.elements.customAmount.addEventListener('input', (event) => {
      if (event.target.value) form.querySelectorAll('input[name=amount]').forEach((input) => (input.checked = false));
    });
    sync();
  })();
</script>
