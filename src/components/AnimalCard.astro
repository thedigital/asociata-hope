---
import type { Locale } from '../i18n/config.ts';
import { localizePath } from '../i18n/config.ts';
import { formatAge, useUi } from '../i18n/ui.ts';
import type { AnimalCard } from '../lib/animals.ts';
import { animalPath } from '../lib/taxonomy.ts';
import Icon from './Icon.astro';
import Picture from './Picture.astro';

interface Props {
  animal: AnimalCard;
  locale: Locale;
  eager?: boolean;
  /** First card of a list: its photo is the largest element of the first screen. */
  priority?: boolean;
  /** Level of the name, under the title of the block that holds the card. */
  heading?: 'h2' | 'h3';
  /** False for an animal without a page (in memoriam): photo and name only. */
  link?: boolean;
}

const { animal, locale, eager = false, priority = false, heading: Heading = 'h3', link = true } = Astro.props;
const Body = link ? 'a' : 'div';
const ui = useUi(locale);
const url = localizePath(animalPath(animal), locale);
const details = [animal.ageMonths === null ? null : formatAge(ui, animal.ageMonths), animal.sex ? ui.sex[animal.sex] : null].filter(Boolean);
---

<li class="animal-card">
  <Body class="animal-card__body" href={link ? url : undefined}>
    {
      animal.photo && (
        <Picture
          kind="animals"
          file={animal.photo.file}
          fallback={400}
          widths={[400, 800]}
          width={400}
          height={400}
          sizes="(min-width: 1100px) 300px, (min-width: 700px) 33vw, 50vw"
          alt={animal.photo.alt || animal.name}
          loading={eager ? 'eager' : 'lazy'}
          priority={priority}
          decoding="async"
        />
      )
    }
    {
      animal.campaign && (
        <span class="animal-card__campaign">
          <Icon name="heart" />
          {ui.campaigns.badge}
        </span>
      )
    }
    <Heading class="animal-card__name">{animal.name}</Heading>
    {link && <p>{details.join(' · ')}</p>}
    {link && <span class="animal-card__more">{ui.animal.learnMore}</span>}
  </Body>
</li>
