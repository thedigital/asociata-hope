---
import type { Locale } from '../i18n/config.ts';
import { useUi } from '../i18n/ui.ts';
import { formatDay, formatMoney, type Campaign } from '../lib/campaigns.ts';

interface Props {
  campaign: Campaign;
  locale: Locale;
}

/**
 * Where a campaign stands: the amount collected against its goal and the time left, or that it has no end.
 * Gifts come in several currencies: the amounts are converted to the one of the language, and a
 * line says so when one of them is not exact.
 */
const { campaign, locale } = Astro.props;
const t = useUi(locale).campaigns;
const { raised, goal } = campaign.shown;
const time = campaign.state === 'reached' ? t.reached : campaign.state === 'ended' ? t.ended : campaign.daysLeft === null ? '' : campaign.daysLeft <= 30 ? t.daysLeft(campaign.daysLeft) : t.until(formatDay(campaign.endsOn!, locale));
---

{
  goal === null ? (
    <p class="campaign-progress campaign-progress--permanent">{t.permanent}</p>
  ) : (
    <div class={`campaign-progress campaign-progress--${campaign.state}`}>
      <p class="campaign-progress__amount">
        <strong>{formatMoney(raised.amount, raised.currency, locale)}</strong> {t.raisedOf(formatMoney(goal.amount, goal.currency, locale))}
      </p>
      <progress max="100" value={campaign.percent}>
        {campaign.percent} %
      </progress>
      <p class="campaign-progress__meta">
        <span>{campaign.percent} %</span>
        <span>{time}</span>
      </p>
      {(raised.approximate || goal.approximate) && <p class="campaign-progress__note">{t.converted(raised.currency.toUpperCase())}</p>}
    </div>
  )
}
