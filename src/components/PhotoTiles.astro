---
import type { Locale } from '../i18n/config.ts';
import { useUi } from '../i18n/ui.ts';
import Picture from './Picture.astro';

interface Props {
  locale: Locale;
  /** Photos of `data/uploads/pages`, cropped to a square. */
  tiles: { label: string; href: string; file: string }[];
  sizes: string;
}

/** Large photo links of the home page. */
const { locale, tiles, sizes } = Astro.props;
const ui = useUi(locale);
---

<ul class="tiles">
  {
    tiles.map((tile) => (
      <li>
        <a href={tile.href}>
          <Picture kind="pages" file={tile.file} widths={[400, 800]} sizes={sizes} alt={ui.photoAlts[tile.file]} width={800} height={800} loading="lazy" />
          <span>{tile.label}</span>
        </a>
      </li>
    ))
  }
</ul>
