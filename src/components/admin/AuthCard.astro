---
interface Props {
  title: string;
  /** False when there is nothing to post (an invitation that is no longer valid). */
  form?: boolean;
}

/** The card of the screens reached without a session: sign-in and choice of credentials. */
const { title, form = true } = Astro.props;
const Card = form ? 'form' : 'div';
---

<Card class="login card" method={form ? 'post' : undefined}>
  <img src="/logo.webp" alt="Hope" width="240" height="49" />
  <h1>{title}</h1>
  <slot />
</Card>
