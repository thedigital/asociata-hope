---
import type { Locale } from '../i18n/config.ts';
import { localizePath } from '../i18n/config.ts';
import { useUi } from '../i18n/ui.ts';
import type { Campaign } from '../lib/campaigns.ts';
import { LINE_ICONS } from '../lib/icons.ts';
import { imageUrl, srcset } from '../lib/media.ts';
import CampaignProgress from './CampaignProgress.astro';

interface Props {
  campaign: Campaign;
  locale: Locale;
  /** Level of the title of the card, under the title of the block that holds it. */
  heading?: 'h2' | 'h3';
}

const { campaign, locale, heading: Heading = 'h3' } = Astro.props;
const t = useUi(locale).campaigns;
---

<li class="campaign-card">
  <a href={localizePath(campaign.path, locale)}>
    {
      campaign.image ? (
        <img
          src={imageUrl(campaign.image.kind, campaign.image.file, 800)}
          srcset={srcset(campaign.image.kind, campaign.image.file, [400, 800])}
          sizes="(min-width: 700px) 360px, 100vw"
          alt=""
          width="800"
          height="533"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="campaign-card__ground">
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={LINE_ICONS.heart} />
        </span>
      )
    }
    <div class="campaign-card__body">
      <p class="campaign-card__scope">{campaign.animal?.name ?? t.scopes[campaign.scope]}</p>
      <Heading lang={campaign.textLocale}>{campaign.title}</Heading>
      {campaign.summary && <p lang={campaign.textLocale}>{campaign.summary}</p>}
      <CampaignProgress campaign={campaign} locale={locale} />
      <span class="animal-card__more">{t.see}</span>
    </div>
  </a>
</li>
