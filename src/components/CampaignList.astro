---
import CampaignGrid from './CampaignGrid.astro';
import PageHero from './PageHero.astro';
import type { Locale } from '../i18n/config.ts';
import { localizePath } from '../i18n/config.ts';
import { useUi } from '../i18n/ui.ts';
import type { Campaign } from '../lib/campaigns.ts';

interface Props {
  campaigns: Campaign[];
  locale: Locale;
}

const { campaigns, locale } = Astro.props;
const ui = useUi(locale);
const t = ui.campaigns;
const open = campaigns.filter((campaign) => campaign.state === 'open');
const closed = campaigns.filter((campaign) => campaign.state !== 'open');
---

<PageHero title={ui.pages.campanii} lead={t.lead} />
<div class="container campaigns">
  {
    open.length > 0 ? (
      <CampaignGrid campaigns={open} locale={locale} heading="h2" />
    ) : (
      <div class="campaigns__empty">
        <p>{t.empty}</p>
        <a class="button" href={localizePath('/doneaza', locale)}>{ui.donate}</a>
      </div>
    )
  }
  {
    closed.length > 0 && (
      <>
        <h2 class="campaigns__past">{t.past}</h2>
        <CampaignGrid campaigns={closed} locale={locale} />
      </>
    )
  }
</div>
