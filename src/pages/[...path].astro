---
import { and, eq } from 'drizzle-orm';
import AnimalDetail from '../components/AnimalDetail.astro';
import AnimalList from '../components/AnimalList.astro';
import ContactForm from '../components/ContactForm.astro';
import DonateMethods from '../components/DonateMethods.astro';
import Home from '../components/Home.astro';
import RedirectDetail from '../components/RedirectDetail.astro';
import { db, schema } from '../db/client.ts';
import { DEFAULT_LOCALE, ENABLED_LOCALES, localizePath, splitLocale } from '../i18n/config.ts';
import { describeContact, useFormsUi } from '../i18n/forms.ts';
import { formatAge, useUi } from '../i18n/ui.ts';
import Base from '../layouts/Base.astro';
import { findCollection, getAnimal, isDeceased, listAnimals, listDeceased } from '../lib/animals.ts';
import { CONTACT_MAX_BYTES, REASONS, emptyContact, isRateLimited, notifyContactMessage, parseContactForm, saveContactMessage, type ContactField } from '../lib/contact.ts';
import { imageSize } from '../lib/image-size.ts';
import { imageUrl, srcset } from '../lib/media.ts';
import { interleaveGallery, splitClosingPhoto, structureBody } from '../lib/page-body.ts';
import { CONTENT_PAGES, PAGE_ILLUSTRATIONS, REMOVED_PATHS, STORY_PAGES, SITE, UNLISTED_PAGES, type ContentPage, type PageKey } from '../lib/site.ts';

/**
 * Single entry point of the public site. URLs are the Wix ones: an optional language prefix,
 * then the same path in every language.
 */
const { locale, path } = splitLocale(Astro.url.pathname);
const ui = useUi(locale);
const segments = path.split('/').filter(Boolean);
const enabled = ENABLED_LOCALES.includes(locale);
const collection = enabled && segments.length <= 2 ? findCollection(segments[0] ?? '') : undefined;
const titleOf = (name: string) => `${name} | ${SITE.name}`;
const truncate = (text: string, max = 158) => (text.length <= max ? text : `${text.slice(0, text.lastIndexOf(' ', max))}…`);

function loadPage(slug: ContentPage) {
  const rows = db
    .select({ locale: schema.pageTranslations.locale, body: schema.pageTranslations.body, seoTitle: schema.pageTranslations.seoTitle, seoDescription: schema.pageTranslations.seoDescription })
    .from(schema.pageTranslations)
    .innerJoin(schema.pages, eq(schema.pages.id, schema.pageTranslations.pageId))
    .where(and(eq(schema.pages.slug, slug)))
    .all();
  return rows.find((r) => r.locale === locale) ?? rows.find((r) => r.locale === DEFAULT_LOCALE) ?? null;
}

const animal = collection && segments.length === 2 ? getAnimal(collection, segments[1], locale) : null;
// The page of an animal that has died is replaced by its place on "In memoriam".
if (collection && segments.length === 2 && !animal && isDeceased(collection, segments[1])) return Astro.redirect(localizePath('/in-memoriam', locale), 301);
const animals = collection && segments.length === 1 ? listAnimals(collection) : null;
const page = enabled && segments.length === 1 && (CONTENT_PAGES as readonly string[]).includes(segments[0]) ? loadPage(segments[0] as ContentPage) : null;
const isHome = enabled && segments.length === 0;
const isContact = enabled && segments.length === 1 && segments[0] === 'contact';
// "In memoriam" is built from the animals with the `deceased` status, not from a stored body.
const memoriam = page && segments[0] === 'in-memoriam' ? listDeceased() : null;
const found = isHome || isContact || animal || animals || page;
if (!found) Astro.response.status = REMOVED_PATHS.includes(path) ? 410 : 404;
// A body that brings its own h1 (as on Wix) provides the page heading, so the page keeps a single h1.
const ownHeading = page?.body.match(/<h1[^>]*>([\s\S]*?)<\/h1>\s*/);
// Every language goes through the same structuring, so a page looks the same whatever the language.
const pageBody = page ? structureBody(ownHeading ? page.body.replace(ownHeading[0], '') : page.body, ui.download) : undefined;

const isStory = page !== null && STORY_PAGES.includes(segments[0] as ContentPage);
const illustration = page ? PAGE_ILLUSTRATIONS[segments[0] as ContentPage] : undefined;
// The photo keeps its own proportions: its real size is given to the browser to avoid a layout shift.
// Beside the text, the photo that closes the body joins the illustration in the photo column.
const split = illustration && pageBody ? splitClosingPhoto(pageBody) : null;
const splitPhotos = illustration ? await Promise.all([...new Set([illustration, ...(split?.photo ? [split.photo] : [])])].map(async (file) => ({ file, size: await imageSize('pages', file) }))) : [];

const key = segments[0] as PageKey;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'AnimalShelter',
  name: SITE.legalName,
  url: Astro.site!.origin,
  logo: `${Astro.site!.origin}/logo.webp`,
  email: SITE.email,
  address: { '@type': 'PostalAddress', addressCountry: 'RO', addressLocality: 'București' },
  sameAs: Object.values(SITE.social),
};

let title = titleOf(ui.notFound.title);
let description = ui.seo.description;
let image: string | undefined;
if (isHome) title = ui.seo.homeTitle;
else if (animal && collection) {
  const facts = [animal.ageMonths === null ? null : formatAge(ui, animal.ageMonths), animal.sex ? ui.sex[animal.sex] : null].filter(Boolean).join(', ');
  title = animal.translation?.seoTitle || `${animal.name} | ${ui.pages[collection.path as PageKey]} | ${SITE.name}`;
  description = animal.translation?.seoDescription || truncate(`${animal.name}${facts ? ` (${facts})` : ''} – ${(animal.translation?.description ?? '').replace(/\s+/g, ' ')}`);
  if (animal.photos[0]) image = imageUrl('animals', animal.photos[0].file, 1200);
} else if (animals || isContact) {
  title = titleOf(ui.pages[key]);
  description = ui.seo.lists?.[key] || description;
}
else if (page) {
  title = page.seoTitle || titleOf(ui.pages[key]);
  description = page.seoDescription || description;
}
const query = Astro.url.searchParams;

// Contact form: links from animal pages pre-fill the reason and the animal's name.
let contact = emptyContact(REASONS.find((r) => r === query.get('reason')) ?? '', query.get('animal')?.slice(0, 80) ?? '');
if (contact.reason === 'redirection') contact.message = useFormsUi(locale).contact.redirectionMessage;
let contactErrors: ContactField[] = [];
let contactState: 'form' | 'sent' | 'limited' = query.has('sent') ? 'sent' : 'form';
if (isContact && Astro.request.method === 'POST') {
  const sent = () => Astro.redirect(`${localizePath('/contact', locale)}?sent=1`, 303);
  // A request too large to hold a valid attachment is refused before its body is read.
  const tooLarge = Number(Astro.request.headers.get('content-length')) > CONTACT_MAX_BYTES;
  const submission = tooLarge ? null : await parseContactForm(await Astro.request.formData());
  if (submission) contact = submission.values;
  if (!submission) {
    contactErrors = ['attachment'];
    Astro.response.status = 413;
  }
  // Bots get the same answer as people, but nothing is stored.
  else if (submission.spam) return sent();
  else if (submission.errors.length) {
    contactErrors = submission.errors;
    Astro.response.status = 422;
  } else if (isRateLimited(Astro.clientAddress)) {
    contactState = 'limited';
    Astro.response.status = 429;
  } else {
    const id = saveContactMessage(contact, locale, submission.attachment);
    // The association reads Romanian, whatever the language of the visitor.
    await notifyContactMessage(contact, id, (values) => describeContact(values, DEFAULT_LOCALE), submission.attachment);
    return sent();
  }
}
const donationAnimal = page && segments[0] === 'doneaza' ? query.get('animal')?.replace(/[\r\n]/g, ' ').slice(0, 80) || null : null;
const isDonation = page !== null && segments[0] === 'doneaza';
// Pages reached with parameters (filters, pre-filled forms, form results) are not indexed.
const filtered = (animals !== null || isContact || isDonation) && [...Astro.url.searchParams.values()].some(Boolean);
const unlisted = page !== null && UNLISTED_PAGES.includes(segments[0] as ContentPage);
---

<Base locale={enabled ? locale : DEFAULT_LOCALE} path={path} title={title} description={description} image={image} noindex={!found || filtered || unlisted} alternates={Boolean(found)} jsonLd={isHome ? [organization] : []}>
  {isHome && <Home locale={locale} />}
  {animals && collection && <AnimalList collection={collection} animals={animals} locale={locale} filters={Astro.url.searchParams} />}
  {animal && collection && <AnimalDetail collection={collection} animal={animal} locale={locale} />}
  {
    page && (
      <>
        <section class="page-hero">{ownHeading ? <h1 set:html={ownHeading[1]} /> : <h1>{ui.pages[key]}</h1>}</section>
        {memoriam ? (
          <div class="container memoriam">
            <ul class="animal-grid">
              {memoriam.map((item) => (
                <li class="animal-card">
                  <div class="animal-card__static">
                    {item.photo && (
                      <img
                        src={imageUrl('animals', item.photo.file, 400)}
                        srcset={srcset('animals', item.photo.file, [400, 800])}
                        sizes="(min-width: 1100px) 300px, (min-width: 700px) 33vw, 50vw"
                        alt={item.photo.alt || item.name}
                        width="400"
                        height="400"
                        loading="lazy"
                      />
                    )}
                    <h2>{item.name}</h2>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ) : isDonation ? (
          <DonateMethods locale={locale} animal={donationAnimal} error={query.get('error')} cancelled={query.has('cancelled')} />
        ) : illustration ? (
          <div class="container page-split">
            <div class="page-split__photos">
              {splitPhotos.map(({ file, size }) => (
                <img class="page-split__image" src={imageUrl('pages', file, 800)} srcset={srcset('pages', file, [400, 800])} sizes="(min-width: 900px) 460px, 100vw" alt="" width={size?.width} height={size?.height} />
              ))}
            </div>
            {segments[0] === 'redirectioneaza' ? (
              <div class="prose prose--plain">
                <RedirectDetail locale={locale} />
              </div>
            ) : (
              <div class="prose prose--plain" set:html={split?.body ?? pageBody} />
            )}
          </div>
        ) : isStory ? (
          <div class="container prose prose--story" set:html={interleaveGallery(pageBody ?? '')} />
        ) : (
          <div class="container prose" set:html={pageBody} />
        )}
      </>
    )
  }
  {
    isContact && (
      <>
        <section class="page-hero">
          <h1>{ui.pages.contact}</h1>
        </section>
        <div class="container prose contact">
          {contactState !== 'sent' && <p>{ui.contactPage.intro}</p>}
          <ContactForm locale={locale} values={contact} errors={contactErrors} state={contactState} />
        </div>
      </>
    )
  }
  {
    !found && (
      <>
        <section class="page-hero">
          <h1>{ui.notFound.title}</h1>
        </section>
        <div class="container prose">
          <p>{ui.notFound.text}</p>
          <p>
            <a class="button" href={localizePath('/', enabled ? locale : DEFAULT_LOCALE)}>
              {ui.notFound.back}
            </a>
          </p>
        </div>
      </>
    )
  }
</Base>
