---
import { useAdminUi } from '../../../i18n/admin.ts';
import { LOCALE_NAMES } from '../../../i18n/config.ts';
import Admin from '../../../layouts/Admin.astro';
import Toolbar from '../../../components/admin/Toolbar.astro';
import { listCampaignsForAdmin } from '../../../lib/admin-campaigns.ts';
import { CAMPAIGNS_PATH, formatDay, formatMoney, formatShown } from '../../../lib/campaigns.ts';
import { CURRENCIES } from '../../../lib/stripe.ts';

const user = Astro.locals.user!;
const t = useAdminUi(user.locale);
const c = t.campaigns;
const rows = listCampaignsForAdmin();
/** What was really received, per currency: "150 RON + 50 €". */
const breakdown = (row: (typeof rows)[number]) =>
  CURRENCIES.filter((v) => row.received[v] > 0).map((v) => formatMoney(row.received[v], v, user.locale)).join(' + ') || formatMoney(0, row.currency, user.locale);
---

<Admin title={t.nav.campaigns}>
  <Toolbar title={t.nav.campaigns}>
    <a class="btn" href="/admin/campaigns/new">+ {c.add}</a>
  </Toolbar>
  <p>{c.intro}</p>

  {
    rows.length === 0 ? (
      <p class="card">{c.empty}</p>
    ) : (
      <table class="table">
        <thead>
          <tr>
            <th>{c.title}</th>
            <th>{c.scope}</th>
            <th>{c.kind}</th>
            <th>{c.raised}</th>
            <th>{t.list.status}</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <td class="table__main">
                <a href={`/admin/campaigns/${row.id}`}>
                  <strong>{row.title}</strong>
                </a>
                {row.untranslated.length > 0 && (
                  <span class="flag flag--warning" title={c.untranslated(row.untranslated.map((l) => LOCALE_NAMES[l]).join(', '))}>
                    {row.untranslated.join(', ').toUpperCase()}
                  </span>
                )}
                {row.status === 'published' && (
                  <div>
                    <a href={`/${CAMPAIGNS_PATH}/${row.slug}`} target="_blank" rel="noopener">
                      <code>/{CAMPAIGNS_PATH}/{row.slug}</code>
                    </a>
                  </div>
                )}
              </td>
              <td>{c.scopes[row.scope]}</td>
              <td>{row.goalAmount === null ? c.permanent : `${c.temporary}, ${formatDay(row.endsOn!, user.locale)}`}</td>
              <td data-label={c.raised}>
                {row.goalAmount === null ? breakdown(row) : `${formatShown(row.raised, user.locale)} / ${formatMoney(row.goalAmount, row.currency, user.locale)}`}
                {row.goalAmount !== null && row.raised.approximate && <div><small>{breakdown(row)}</small></div>}
              </td>
              <td>
                <span class={`badge badge--${row.status}`}>{c.statuses[row.status]}</span>
                {row.status === 'published' && row.state !== 'open' && <span class="badge badge--adopted">{c.states[row.state]}</span>}
              </td>
              <td>
                <a href={`/admin/campaigns/${row.id}`}>{t.list.edit}</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</Admin>
