---
import { useAdminUi } from '../../../i18n/admin.ts';
import { LOCALES, localizePath, type Locale } from '../../../i18n/config.ts';
import { useUi } from '../../../i18n/ui.ts';
import LanguageDetails from '../../../components/admin/LanguageDetails.astro';
import Notice from '../../../components/admin/Notice.astro';
import SeoFields from '../../../components/admin/SeoFields.astro';
import Toolbar from '../../../components/admin/Toolbar.astro';
import Admin from '../../../layouts/Admin.astro';
import { getPageForEdit, isSeoPage, parsePageForm, savePage, type PageFormError } from '../../../lib/admin-pages.ts';
import { automaticPageSeo } from '../../../lib/seo.ts';
import { HOME_PAGE } from '../../../lib/site.ts';

const user = Astro.locals.user!;
const t = useAdminUi(user.locale);
const p = t.pages;
const f = t.form;

const slug = Astro.params.slug ?? '';
if (!isSeoPage(slug)) return new Response('Not found', { status: 404 });
// The home page is stored under a name of its own: its address is the root of the site.
const path = slug === HOME_PAGE ? '/' : `/${slug}`;

let errors: PageFormError[] = [];
let submitted: ReturnType<typeof parsePageForm>['translations'] | null = null;
if (Astro.request.method === 'POST') {
  const result = parsePageForm(await Astro.request.formData());
  if (!result.errors.length) {
    savePage(slug, result.translations);
    return Astro.redirect(`/admin/pages/${slug}?saved=1`, 303);
  }
  ({ translations: submitted, errors } = result);
  Astro.response.status = 422;
}

const stored = getPageForEdit(slug);
// Values shown in the form: what was just submitted (on error), else what is stored.
const translation = (locale: Locale) => (submitted ?? stored.translations).find((tr) => tr.locale === locale);
const title = slug === HOME_PAGE ? p.home : useUi(user.locale).pages[slug];
// What the public page uses when a field is left empty (src/pages/[...path].astro).
const automatic = (locale: Locale) => automaticPageSeo(slug, locale);
---

<Admin title={title}>
  <Toolbar title={title} back="/admin/pages" view={path} />

  {Astro.url.searchParams.has('saved') && <Notice kind="ok">{f.saved}</Notice>}
  {errors.map((error) => <Notice kind="error">{p.errors[error]}</Notice>)}

  <form class="form" method="post">
    <fieldset class="card">
      <legend>{p.seo}</legend>
      <small>{p.seoHelp}</small>
      {
        LOCALES.map((locale) => (
          <LanguageDetails
            locale={locale}
            filled={Boolean(translation(locale)?.seoTitle || translation(locale)?.seoDescription)}
            open
            view={localizePath(path, locale)}
          >
            <SeoFields
              locale={locale}
              title={translation(locale)?.seoTitle}
              description={translation(locale)?.seoDescription}
              automatic={automatic(locale)}
            />
          </LanguageDetails>
        ))
      }
    </fieldset>

    <div class="actions">
      <button class="btn" type="submit">{f.save}</button>
    </div>
  </form>
</Admin>
