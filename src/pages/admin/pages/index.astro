---
import { useAdminUi } from '../../../i18n/admin.ts';
import { LOCALE_NAMES } from '../../../i18n/config.ts';
import { useUi } from '../../../i18n/ui.ts';
import Admin from '../../../layouts/Admin.astro';
import { listPagesForAdmin } from '../../../lib/admin-pages.ts';
import { HOME_PAGE, UNLISTED_PAGES, type ContentPage } from '../../../lib/site.ts';

const user = Astro.locals.user!;
const t = useAdminUi(user.locale);
const p = t.pages;
// Page names are those of the public menu, in the language of the admin user (Romanian or French).
const ui = useUi(user.locale);
const rows = listPagesForAdmin();
const date = new Intl.DateTimeFormat(user.locale, { dateStyle: 'medium', timeStyle: 'short' });
---

<Admin title={t.nav.pages}>
  <div class="toolbar">
    <h1>{t.nav.pages}</h1>
  </div>
  <p>{p.intro}</p>

  <table class="table">
    <thead>
      <tr>
        <th>{p.page}</th>
        <th>{p.address}</th>
        <th>{p.written}</th>
        <th>{p.updated}</th>
        <th />
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td class="table__main">
              <a href={`/admin/pages/${row.slug}`}>
                <strong>{row.slug === HOME_PAGE ? p.home : ui.pages[row.slug]}</strong>
              </a>
              {UNLISTED_PAGES.includes(row.slug as ContentPage) && <span class="badge">{p.unlisted}</span>}
            </td>
            <td>
              <a href={row.slug === HOME_PAGE ? '/' : `/${row.slug}`} target="_blank" rel="noopener">
                <code>{row.slug === HOME_PAGE ? '/' : `/${row.slug}`}</code>
              </a>
            </td>
            <td data-label={p.written}>{row.written.length ? row.written.map((l) => LOCALE_NAMES[l]).join(', ') : p.automatic}</td>
            <td data-label={p.updated}>{row.updatedAt ? <time datetime={row.updatedAt.toISOString()}>{date.format(row.updatedAt)}</time> : p.never}</td>
            <td>
              <a class="btn btn--light" href={`/admin/pages/${row.slug}`}>
                {p.edit}
              </a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Admin>
