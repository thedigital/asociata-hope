# SQLite file (outside the public directory)
DATABASE_PATH=data/hope.db
# Uploads (data/uploads) and resized image cache (data/cache)
DATA_DIR=data

# Public address when it differs from the production one (test domain): Stripe return URLs, and host
# accepted behind the reverse proxy (read at build time, see astro.config.ts).
SITE_URL=

# Card donations (Stripe Checkout). Without it the donation page explains that card payment is unavailable.
STRIPE_SECRET_KEY=

# E-mail notification of contact messages. Without it messages are only listed in the admin.
# Example: smtps://user:password@smtp.example.org:465
SMTP_URL=
# Optional: sender and recipient (default: the association's address)
MAIL_FROM=
CONTACT_TO=
